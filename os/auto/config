#!/bin/sh
# Opções do live-build para o E OS 0.2 (x86-64), com a interface Fusão.
# O live-build roda este script quando você chama "lb config".
set -e

# Parâmetros do kernel comuns às entradas "Experimentar" do menu de boot.
EOS_BOOT="boot=live components hostname=eos username=eos locales=pt_BR.UTF-8 keyboard-layouts=br timezone=America/Sao_Paulo console=ttyS0,115200 console=tty0"

# O instalador é o Debian Installer no modo "live": ele copia o próprio
# sistema da ISO para o disco. Gráfico e texto.
lb config noauto \
  --mode debian \
  --distribution trixie \
  --architecture amd64 \
  --archive-areas "main contrib non-free non-free-firmware" \
  --binary-images iso-hybrid \
  --debian-installer live \
  --debian-installer-gui true \
  --loadlin false \
  --win32-loader false \
  --apt-recommends false \
  --apt-indices false \
  --firmware-binary false \
  --firmware-chroot false \
  --memtest none \
  --chroot-squashfs-compression-type zstd \
  --chroot-squashfs-compression-level 19 \
  --image-name eos-0.2 \
  --iso-application "E OS" \
  --iso-publisher "Projeto E OS" \
  --iso-volume "E OS 0.2" \
  --bootappend-live "$EOS_BOOT quiet" \
  --bootappend-live-failsafe "$EOS_BOOT noapic noapm nodma nomce nosmp nomodeset" \
  "${@}"
