# E OS Fusão: programas que abrem junto com a interface (rodado pelo labwc).
log="${XDG_RUNTIME_DIR:-/tmp}"

dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_CONFIG_DIRS >/dev/null 2>&1
xdg-user-dirs-update >/dev/null 2>&1

swaybg -i /usr/share/backgrounds/eos/fusao.png -m fill >"$log/eos-fundo.log" 2>&1 &
waybar -c /usr/share/eos/xdg/waybar/config.jsonc -s /usr/share/eos/xdg/waybar/style.css >"$log/eos-barra.log" 2>&1 &
swaync -c /usr/share/eos/xdg/swaync/config.json -s /usr/share/eos/xdg/swaync/style.css >"$log/eos-painel.log" 2>&1 &
nm-applet --indicator >"$log/eos-rede.log" 2>&1 &
lxpolkit >/dev/null 2>&1 &

# Boas-vindas, no estilo das notificações do Android. Na sessão live, explica
# como instalar.
if [ -d /run/live/medium ]; then
  texto="Experimente à vontade. Para instalar no computador, clique em Instalar o E OS, o primeiro ícone do dock."
else
  texto="Super + Espaço abre a busca. O painel rápido fica no canto superior direito."
fi
( sleep 5; notify-send -a "E OS" -i /usr/share/eos/icones/inicio.svg "Bem-vindo ao E OS 0.2" "$texto" ) &
